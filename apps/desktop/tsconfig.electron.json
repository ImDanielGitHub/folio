{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "types": ["node", "electron"],
    "outDir": "dist-electron",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.cts"]
}
