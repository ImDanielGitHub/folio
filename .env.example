# The API must remain loopback-only in P0.
FINANCE_API_HOST=127.0.0.1
FINANCE_API_PORT=8787
FINANCE_DATABASE_PATH=./var/finance-agent.sqlite3
# Optional outside ./run. The launcher generates an ephemeral value when blank.
FOLIO_SESSION_TOKEN=

# local | hybrid | cloud
FINANCE_MODEL_MODE=local
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=

# Optional. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional read-only Akahu live sync. Inject at process start; Folio never stores these.
FINANCE_AKAHU_ENABLED=false
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Optional read-only Plaid sandbox Link. Fixture is the default demo path.
# Live only when enabled with client id + secret. Never commit real credentials.
FINANCE_PLAID_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Optional: skip Link by injecting a sandbox access token.
PLAID_ACCESS_TOKEN=
PLAID_CLIENT_NAME=Folio

TELEGRAM_LIVE_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
